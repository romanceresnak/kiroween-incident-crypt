# Terraform state — never commit
*.tfstate
*.tfstate.*

# Terraform working directories
.terraform/
# .terraform.lock.hcl is committed — do not ignore it

# Local variable overrides — use TF_VAR_* in CI instead
terraform.tfvars

# Crash log
crash.log

# Saved plans
*.tfplan
tfplan

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node (tools/ui-tests)
node_modules/
